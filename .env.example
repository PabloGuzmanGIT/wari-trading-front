# URL pública del sitio en producción (sin barra final). Usada por metadata,
# canonical, hreflang, OpenGraph, sitemap y llms.txt.
# Elegir UNA forma canónica (apex sin www) y hacer el redirect www -> apex.
NEXT_PUBLIC_SITE_URL=https://waritradingfoods.com

# Backend para las llamadas del SERVIDOR (sitemap, blog en SSR/ISR) y destino
# del proxy /api/* del navegador. En Railway: la red privada del backend
# (no consume egress). El puerto es el que expone el servicio backend.
#   API_INTERNAL_URL=http://wari-trading-back.railway.internal:8080
# En local se omite y cae a http://127.0.0.1:8000.
API_INTERNAL_URL=

# Base para las llamadas del NAVEGADOR. Vacío = ruta relativa /api/* (mismo
# origen, sin CORS, reenviada por next.config.ts). Dejar vacío salvo que el
# frontend deba pegarle a un backend en otro dominio.
NEXT_PUBLIC_API_URL=

# Token de verificación de Google Search Console (solo el valor del atributo
# content="...", no la etiqueta completa). Opcional: si prefieres verificar por
# TXT DNS, deja esto vacío. Si se define, se emite
# <meta name="google-site-verification" ...> en todas las páginas.
GOOGLE_SITE_VERIFICATION=
